# -----------------------------------------------------------------------------
# Zwischenraum – Umgebungsvariablen
# Kopiere diese Datei nach ".env.local" und trage deine Werte ein.
# .env.local wird NICHT ins Git-Repository hochgeladen.
# Werte findest du im Supabase-Dashboard unter: Project Settings -> API Keys
# bzw. über den "Connect"-Button oben im Dashboard.
# -----------------------------------------------------------------------------

# Projekt-URL, z. B. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Öffentlicher Schlüssel ("Publishable key", beginnt mit sb_publishable_ ...
# oder bei älteren Projekten der "anon"-Schlüssel). Darf öffentlich sein –
# der Schutz der Daten erfolgt über Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Öffentliche Adresse der App (lokal http://localhost:3000, später die
# Vercel-Adresse). Wird für Links in Bestätigungs-E-Mails verwendet.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GEHEIMER Schlüssel ("Secret key", beginnt mit sb_secret_ ... bzw. älter
# "service_role"). NUR für "npm run seed" und "npm run test:rls" auf deinem
# eigenen Rechner. NIEMALS in Vercel eintragen, NIEMALS teilen.
SUPABASE_SECRET_KEY=
